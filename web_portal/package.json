{
  "name": "nermai_ias_academy_web_portal",
  "version": "1.0.0",
  "description": "Integrated NERMAI IAS Academy Web Portal with LMS",
  "main": "index.ts",
  "scripts": {
    "dev": "concurrently \"npm run web\" \"cd ../backend && npm run start\"",
    "start": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --web",
    "web": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --web",
    "clear": "npx expo start --web --clear",
    "build": "npx expo export -p web",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-query-persist-client": "^5.56.2",
    "@zoom/meetingsdk": "^6.2.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.37",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-print": "~15.0.8",
    "expo-screen-capture": "~8.0.10",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.16.0",
    "framer-motion": "^11.11.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.47",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^9.0.1",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-pdf": "^9.1.1",
    "react-router-dom": "^6.26.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.13",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "concurrently": "^10.0.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
